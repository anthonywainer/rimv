<Window x:Class="RimV.Windows.ModelSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:RimV.Windows" Title="Model">
    <Grid x:Name="RootGrid" Background="Transparent" KeyDown="RootGrid_KeyDown">
        <Border x:Name="PopupSurface" Background="{ThemeResource RimVMenuSurfaceBrush}"
                BorderBrush="{ThemeResource RimVMenuBorderBrush}" BorderThickness="1"
                CornerRadius="16" Padding="18,14">
            <Border.Shadow><ThemeShadow /></Border.Shadow>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Model" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource RimVMenuTextBrush}" />
                <ScrollViewer Grid.Row="1" MaxHeight="104" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="ModelList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ModelSelectorRow">
                                    <Button Tag="{x:Bind Id}" Click="ModelOption_Click" Padding="0" MinHeight="48"
                                            HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                            IsEnabled="{x:Bind CanSelect}" AutomationProperties.Name="{x:Bind AccessibleName}">
                                        <Grid Padding="2,4" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource RimVMenuTextBrush}" />
                                                <TextBlock Text="{x:Bind Status}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource RimVMenuSecondaryTextBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Checkmark}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource RimVMenuAccentBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyText" Text="No models are available in the shared core."
                                   FontSize="12" Foreground="{ThemeResource RimVMenuSecondaryTextBrush}" Padding="2,8" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2">
                    <Border Height="1" Background="{ThemeResource RimVMenuBorderBrush}" Margin="0,2,0,5" />
                    <Button Content="Manage Models…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="0,4" Background="Transparent" BorderThickness="0"
                            Foreground="{ThemeResource RimVMenuSecondaryTextBrush}" Click="ManageModels_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <Canvas x:Name="LeftPointer" Width="14" Height="24" HorizontalAlignment="Left" Visibility="Collapsed">
            <Polygon Points="14,0 14,24 0,12" Fill="{ThemeResource RimVMenuBorderBrush}" />
            <Polygon Points="14,2 14,22 2,12" Fill="{ThemeResource RimVMenuSurfaceBrush}" />
        </Canvas>
        <Canvas x:Name="RightPointer" Width="14" Height="24" HorizontalAlignment="Right" Visibility="Collapsed">
            <Polygon Points="0,0 0,24 14,12" Fill="{ThemeResource RimVMenuBorderBrush}" />
            <Polygon Points="0,2 0,22 12,12" Fill="{ThemeResource RimVMenuSurfaceBrush}" />
        </Canvas>
    </Grid>
</Window>
