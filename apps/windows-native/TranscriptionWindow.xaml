<Window
    x:Class="RimV.Windows.TranscriptionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RimV Transcription">
    <Grid x:Name="RootGrid" Background="{ThemeResource RimVBackgroundBrush}" Padding="24" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="SessionTitle" Text="Transcript" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SessionStatus" Text="Loading recording…" Foreground="{ThemeResource RimVSecondaryTextBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Copy" Click="CopyButton_Click" AutomationProperties.Name="Copy transcript" />
        </Grid>
        <InfoBar x:Name="ErrorInfo" Grid.Row="1" IsOpen="False" Severity="Error" IsClosable="True" />
        <ListView x:Name="TranscriptList" Grid.Row="2" SelectionMode="Multiple" AutomationProperties.Name="Transcript">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TranscriptRow" xmlns:local="using:RimV.Windows">
                    <StackPanel Padding="8,10" Spacing="4">
                        <TextBlock Text="{x:Bind Text}" FontSize="16" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind StateText}" FontSize="12" Foreground="{ThemeResource RimVSecondaryTextBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyText" Grid.Row="2" Text="Your transcript will appear here while listening." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource RimVSecondaryTextBrush}" />
        <MediaPlayerElement x:Name="AudioPlayer" Grid.Row="3" AreTransportControlsEnabled="True" Visibility="Collapsed" AutomationProperties.Name="Recording playback" />
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Content="Rename" Click="RenameButton_Click" AutomationProperties.Name="Rename recording" />
            <Button Grid.Column="1" x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" IsEnabled="False" Visibility="Collapsed" AutomationProperties.Name="Delete recording" />
            <Button Grid.Column="2" Content="Export TXT" Click="ExportTxtButton_Click" />
            <Button Grid.Column="3" Content="Export JSON" Click="ExportJsonButton_Click" />
        </Grid>
    </Grid>
</Window>
