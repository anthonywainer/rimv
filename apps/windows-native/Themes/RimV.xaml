<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="RimVBackgroundBrush" Color="#EEF2FA" />
            <SolidColorBrush x:Key="RimVSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RimVSecondaryBrush" Color="#F6F7FB" />
            <SolidColorBrush x:Key="RimVBorderBrush" Color="#E3E6EF" />
            <SolidColorBrush x:Key="RimVTextBrush" Color="#171827" />
            <SolidColorBrush x:Key="RimVSecondaryTextBrush" Color="#5E6475" />
            <SolidColorBrush x:Key="RimVBrandBrush" Color="#6D4DE6" />
            <SolidColorBrush x:Key="RimVPrimaryForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RimVLiveBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="RimVErrorBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="RimVMenuSurfaceBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="RimVMenuPanelBrush" Color="#F4F6F6" />
            <SolidColorBrush x:Key="RimVMenuBorderBrush" Color="#D8DEDE" />
            <SolidColorBrush x:Key="RimVMenuTextBrush" Color="#17191A" />
            <SolidColorBrush x:Key="RimVMenuSecondaryTextBrush" Color="#656B6D" />
            <SolidColorBrush x:Key="RimVMenuAccentBrush" Color="#0F817C" />
            <SolidColorBrush x:Key="RimVMenuSelectionTextBrush" Color="#0B6E69" />
            <SolidColorBrush x:Key="RimVMenuDisabledTextBrush" Color="#596365" />
            <SolidColorBrush x:Key="RimVMenuDisabledBackgroundBrush" Color="#E7EBEB" />
            <SolidColorBrush x:Key="RimVMenuActionForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RimVMenuSelectedBackgroundBrush" Color="#E5F5F3" />
            <SolidColorBrush x:Key="RimVMenuReadyBackgroundBrush" Color="#DDF2E6" />
            <SolidColorBrush x:Key="RimVMenuReadyTextBrush" Color="#087D3C" />
            <SolidColorBrush x:Key="RimVMenuLiveBackgroundBrush" Color="#FFF0F1" />
            <SolidColorBrush x:Key="RimVMenuLiveTextBrush" Color="#C53C4A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="RimVBackgroundBrush" Color="#0B0F19" />
            <SolidColorBrush x:Key="RimVSurfaceBrush" Color="#111827" />
            <SolidColorBrush x:Key="RimVSecondaryBrush" Color="#172033" />
            <SolidColorBrush x:Key="RimVBorderBrush" Color="#263244" />
            <SolidColorBrush x:Key="RimVTextBrush" Color="#F9FAFB" />
            <SolidColorBrush x:Key="RimVSecondaryTextBrush" Color="#CBD5E1" />
            <SolidColorBrush x:Key="RimVBrandBrush" Color="#A78BFA" />
            <SolidColorBrush x:Key="RimVPrimaryForegroundBrush" Color="#0B0F19" />
            <SolidColorBrush x:Key="RimVLiveBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="RimVErrorBrush" Color="#F87171" />
            <SolidColorBrush x:Key="RimVMenuSurfaceBrush" Color="#1A2023" />
            <SolidColorBrush x:Key="RimVMenuPanelBrush" Color="#242C2F" />
            <SolidColorBrush x:Key="RimVMenuBorderBrush" Color="#3A4649" />
            <SolidColorBrush x:Key="RimVMenuTextBrush" Color="#F7FAFA" />
            <SolidColorBrush x:Key="RimVMenuSecondaryTextBrush" Color="#C3CCCE" />
            <SolidColorBrush x:Key="RimVMenuAccentBrush" Color="#0F817C" />
            <SolidColorBrush x:Key="RimVMenuSelectionTextBrush" Color="#72D7D0" />
            <SolidColorBrush x:Key="RimVMenuDisabledTextBrush" Color="#C3CCCE" />
            <SolidColorBrush x:Key="RimVMenuDisabledBackgroundBrush" Color="#3A4649" />
            <SolidColorBrush x:Key="RimVMenuActionForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RimVMenuSelectedBackgroundBrush" Color="#173B39" />
            <SolidColorBrush x:Key="RimVMenuReadyBackgroundBrush" Color="#174B34" />
            <SolidColorBrush x:Key="RimVMenuReadyTextBrush" Color="#84E1A7" />
            <SolidColorBrush x:Key="RimVMenuLiveBackgroundBrush" Color="#4B232E" />
            <SolidColorBrush x:Key="RimVMenuLiveTextBrush" Color="#FF9198" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="RimVBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVSecondaryBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVBrandBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RimVPrimaryForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="RimVLiveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RimVErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVMenuSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVMenuPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVMenuBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVMenuTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVMenuSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVMenuAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RimVMenuSelectionTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVMenuDisabledTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="RimVMenuDisabledBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVMenuActionForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="RimVMenuSelectedBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVMenuReadyBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVMenuReadyTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVMenuLiveBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVMenuLiveTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="RimVPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource RimVBrandBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource RimVPrimaryForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="RimVSourceButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource RimVMenuSurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource RimVMenuTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource RimVMenuBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style x:Key="RimVMenuListenButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource RimVMenuAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource RimVMenuActionForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style x:Key="RimVMenuRowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource RimVMenuTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="55" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
</ResourceDictionary>
