            <SolidColorBrush x:Key="RimVMenuPanelBrush" Color="#242C2F" />
            <SolidColorBrush x:Key="RimVMenuBorderBrush" Color="#3A4649" />
            <SolidColorBrush x:Key="RimVMenuTextBrush" Color="#F7FAFA" />
            <SolidColorBrush x:Key="RimVMenuSecondaryTextBrush" Color="#C3CCCE" />
            <SolidColorBrush x:Key="RimVMenuAccentBrush" Color="#0B6E69" />
            <SolidColorBrush x:Key="RimVMenuSelectionTextBrush" Color="#72D7D0" />
            <SolidColorBrush x:Key="RimVMenuDisabledTextBrush" Color="#C3CCCE" />
            <SolidColorBrush x:Key="RimVMenuDisabledBackgroundBrush" Color="#3A4649" />
            <SolidColorBrush x:Key="RimVMenuActionForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RimVMenuPrimaryActionBrush" Color="#0B6E69" />
            <SolidColorBrush x:Key="RimVMenuPrimaryActionForegroundBrush" Color="#F9FAFB" />
            <SolidColorBrush x:Key="RimVMenuSelectedBackgroundBrush" Color="#173B39" />
            <SolidColorBrush x:Key="RimVMenuHoverBackgroundBrush" Color="#0F817C" />
            <SolidColorBrush x:Key="RimVMenuPressedBackgroundBrush" Color="#095F5B" />
            <SolidColorBrush x:Key="RimVMenuReadyBackgroundBrush" Color="#14532D" />
            <SolidColorBrush x:Key="RimVMenuReadyTextBrush" Color="#86EFAC" />
            <SolidColorBrush x:Key="RimVMenuLiveBackgroundBrush" Color="#14532D" />
            <SolidColorBrush x:Key="RimVMenuLiveTextBrush" Color="#86EFAC" />
            <SolidColorBrush x:Key="RimVMenuStopBackgroundBrush" Color="#7F1D1D" />
            <SolidColorBrush x:Key="RimVMenuStopTextBrush" Color="#FCA5A5" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="RimVBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVSecondaryBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVPartialTranscriptBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="RimVBrandBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RimVPrimaryForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="RimVLiveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RimVErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVMenuSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVMenuPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVMenuBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVMenuTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVMenuSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVMenuAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RimVMenuSelectionTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVMenuDisabledTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="RimVMenuDisabledBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVMenuActionForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="RimVMenuPrimaryActionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RimVMenuPrimaryActionForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="RimVMenuSelectedBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVMenuHoverBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RimVMenuPressedBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RimVMenuReadyBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVMenuReadyTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVMenuLiveBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVMenuLiveTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RimVMenuStopBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RimVMenuStopTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="RimVPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource RimVMenuPrimaryActionBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource RimVMenuPrimaryActionForegroundBrush}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="RimVSourceButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource RimVMenuSurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource RimVMenuTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource RimVMenuBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style x:Key="RimVMenuListenButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource RimVMenuPrimaryActionBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource RimVMenuPrimaryActionForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style x:Key="RimVMenuRowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource RimVMenuTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="55" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
</ResourceDictionary>
