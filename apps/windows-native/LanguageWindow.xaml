<Window
    x:Class="RimV.Windows.LanguageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Language">
    <Grid x:Name="RootGrid" Background="{ThemeResource RimVBackgroundBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="Transcription language" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="ModelHint" Text="Choose a language supported by the selected model." Foreground="{ThemeResource RimVSecondaryTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="Search languages" AutomationProperties.Name="Search languages" TextChanged="SearchBox_TextChanged" />
        <ListView x:Name="LanguageList" Grid.Row="2" SelectionChanged="LanguageList_SelectionChanged" AutomationProperties.Name="Supported languages">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Padding="8,6" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyText" Grid.Row="2" Text="Select an installed model to choose a language." TextWrapping="Wrap" Foreground="{ThemeResource RimVSecondaryTextBrush}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock Grid.Row="3" Text="Automatic lets the selected model detect the language when supported." FontSize="12" Foreground="{ThemeResource RimVSecondaryTextBrush}" TextWrapping="Wrap" />
    </Grid>
</Window>
