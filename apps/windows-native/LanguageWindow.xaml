<Window x:Class="RimV.Windows.LanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:RimV.Windows" Title="Language">
    <Grid x:Name="RootGrid" Background="Transparent" KeyDown="RootGrid_KeyDown">
        <Border x:Name="PopupSurface" Background="{ThemeResource RimVMenuSurfaceBrush}"
                BorderBrush="{ThemeResource RimVMenuBorderBrush}" BorderThickness="1"
                CornerRadius="16" Padding="18,14">
            <Border.Shadow><ThemeShadow /></Border.Shadow>
            <Grid RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Language" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource RimVMenuTextBrush}" />
                    <TextBlock x:Name="CurrentLanguage" Grid.Column="1" MaxWidth="130" TextTrimming="CharacterEllipsis"
                               FontSize="12" Foreground="{ThemeResource RimVMenuSecondaryTextBrush}" VerticalAlignment="Center" />
                </Grid>
                <Border Grid.Row="1" Height="1" Background="{ThemeResource RimVMenuBorderBrush}" />
                <Grid Grid.Row="2" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBox x:Name="SearchBox" PlaceholderText="Search languages…" AutomationProperties.Name="Search languages"
                             TextChanged="SearchBox_TextChanged" Height="34" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="PopularHeader" Text="POPULAR LANGUAGES" FontSize="10" FontWeight="Bold"
                                       Foreground="{ThemeResource RimVMenuSecondaryTextBrush}" Margin="8,5,0,0" />
                            <ItemsControl x:Name="PopularList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:LanguageSelectorRow">
                                        <Button Tag="{x:Bind Code}" Click="LanguageOption_Click" Padding="0" Height="34"
                                                HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                                AutomationProperties.Name="{x:Bind AccessibleName}">
                                            <Border Background="{x:Bind Background}" CornerRadius="7" Padding="9,3">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Flag}" FontSize="15" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center"
                                                               Foreground="{ThemeResource RimVMenuTextBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Checkmark}" FontSize="17" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource RimVMenuAccentBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="AllHeader" Text="ALL SUPPORTED LANGUAGES" FontSize="10" FontWeight="Bold"
                                       Foreground="{ThemeResource RimVMenuSecondaryTextBrush}" Margin="8,8,0,0" Visibility="Collapsed" />
                            <ItemsControl x:Name="AllList" Visibility="Collapsed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:LanguageSelectorRow">
                                        <Button Tag="{x:Bind Code}" Click="LanguageOption_Click" Padding="0" Height="34"
                                                HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                                AutomationProperties.Name="{x:Bind AccessibleName}">
                                            <Border Background="{x:Bind Background}" CornerRadius="7" Padding="9,3">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Flag}" FontSize="15" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center"
                                                               Foreground="{ThemeResource RimVMenuTextBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Checkmark}" FontSize="17" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource RimVMenuAccentBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="EmptyText" Text="No supported languages match this search."
                                       Foreground="{ThemeResource RimVMenuSecondaryTextBrush}" Padding="8" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Button x:Name="AllLanguagesButton" Grid.Row="3" Content="All supported languages  ›"
                        HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0"
                        Foreground="{ThemeResource RimVMenuAccentBrush}" Click="AllLanguagesButton_Click" />
                <TextBlock Grid.Row="4" Text="Only languages supported by the selected transcription model are shown."
                           FontSize="10" Foreground="{ThemeResource RimVMenuSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
        <Canvas x:Name="LeftPointer" Width="14" Height="24" HorizontalAlignment="Left" Visibility="Collapsed">
            <Polygon Points="14,0 14,24 0,12" Fill="{ThemeResource RimVMenuBorderBrush}" />
            <Polygon Points="14,2 14,22 2,12" Fill="{ThemeResource RimVMenuSurfaceBrush}" />
        </Canvas>
        <Canvas x:Name="RightPointer" Width="14" Height="24" HorizontalAlignment="Right" Visibility="Collapsed">
            <Polygon Points="0,0 0,24 14,12" Fill="{ThemeResource RimVMenuBorderBrush}" />
            <Polygon Points="0,2 0,22 12,12" Fill="{ThemeResource RimVMenuSurfaceBrush}" />
        </Canvas>
    </Grid>
</Window>
