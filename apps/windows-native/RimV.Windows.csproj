<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <RootNamespace>RimV.Windows</RootNamespace>
    <AssemblyName>RimV.Windows</AssemblyName>
    <Version>0.1.0-beta</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64;ARM64</Platforms>
    <ApplicationIcon>..\windows\icons\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the experimental Windows AI Speech surface behind the host adapter. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.2-experimentalA" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\windows-native-application\RimV.Windows.Application.csproj" />
    <Using Include="RimV.Windows.Application" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\windows\icons\icon.ico" Link="Assets\rimv.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Flags\*.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildSharedRustCore" BeforeTargets="Build" Condition="'$(BuildRimvCore)' == 'true'">
    <PropertyGroup>
      <RimvCargoTarget Condition="'$(Platform)' == 'ARM64'">aarch64-pc-windows-msvc</RimvCargoTarget>
      <RimvCargoTarget Condition="'$(Platform)' != 'ARM64'">x86_64-pc-windows-msvc</RimvCargoTarget>
    </PropertyGroup>
    <Exec Command="cargo build --locked --release --target $(RimvCargoTarget) -p rimv-ffi" WorkingDirectory="$(MSBuildThisFileDirectory)..\.." />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\target\$(RimvCargoTarget)\release\rimv_core_ffi.dll" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
