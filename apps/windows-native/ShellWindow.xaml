<Window x:Class="RimV.Windows.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:RimV.Windows" Title="RimV">
    <Grid x:Name="RootGrid" Background="Transparent" KeyDown="RootGrid_KeyDown">
        <Border x:Name="MenuSurface" Background="{ThemeResource RimVMenuSurfaceBrush}"
                BorderBrush="{ThemeResource RimVMenuBorderBrush}" BorderThickness="1"
                CornerRadius="16" Padding="16,16,16,10">
            <ScrollViewer x:Name="MenuScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid ColumnSpacing="12" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="11" Background="{ThemeResource RimVMenuAccentBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="2" Height="10" CornerRadius="1" Background="White"/>
                                <Border Width="2" Height="21" CornerRadius="1" Background="White"/>
                                <Border Width="2" Height="30" CornerRadius="1" Background="White"/>
                                <Border Width="2" Height="19" CornerRadius="1" Background="White"/>
                                <Border Width="2" Height="10" CornerRadius="1" Background="White"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="RimV" FontSize="25" FontWeight="SemiBold" Foreground="{ThemeResource RimVMenuTextBrush}"/>
                            <TextBlock Text="Real-time transcription" FontSize="13" Foreground="{ThemeResource RimVMenuSecondaryTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="2" x:Name="StatusBadge" Background="{ThemeResource RimVMenuReadyBackgroundBrush}"
                                CornerRadius="16" Padding="9,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse x:Name="StatusDot" Width="9" Height="9" VerticalAlignment="Center"
                                         Fill="{ThemeResource RimVMenuReadyTextBrush}"/>
                                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource RimVMenuReadyTextBrush}"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource RimVMenuBorderBrush}" Margin="0,0,0,16"/>
                    <Border Background="{ThemeResource RimVMenuPanelBrush}" CornerRadius="14"
                            Padding="13" Margin="0,0,0,12">
                        <StackPanel Spacing="11">
                            <TextBlock Text="CAPTURE SOURCE" FontSize="11" FontWeight="Bold"
                                       Foreground="{ThemeResource RimVMenuTextBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:HandCursorToggleButton x:Name="SystemSource" Tag="system" Height="70"
                                              Style="{StaticResource RimVSourceButtonStyle}" Click="SourceButton_Click"
                                              AutomationProperties.Name="System audio capture source">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                                        <TextBlock Text="System" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </local:HandCursorToggleButton>
                                <local:HandCursorToggleButton x:Name="MicrophoneSource" Grid.Column="1" Tag="microphone" Height="70"
                                              Style="{StaticResource RimVSourceButtonStyle}" Click="SourceButton_Click"
                                              AutomationProperties.Name="Microphone capture source">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE720;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                                        <TextBlock Text="Microphone" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </local:HandCursorToggleButton>
                                <local:HandCursorToggleButton x:Name="BothSource" Grid.Column="2" Tag="both" Height="70"
                                              Style="{StaticResource RimVSourceButtonStyle}" Click="SourceButton_Click"
                                              AutomationProperties.Name="System and microphone capture source">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                                        <TextBlock Text="Both" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </local:HandCursorToggleButton>
                            </Grid>
                            <Button x:Name="ListenButton" Height="52" HorizontalAlignment="Stretch"
                                    Style="{StaticResource RimVMenuListenButtonStyle}" Click="ListenButton_Click"
                                    AutomationProperties.Name="Start listening">
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <FontIcon x:Name="ListenIcon" Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                              Foreground="{ThemeResource RimVMenuActionForegroundBrush}"/>
                                    <TextBlock x:Name="ListenLabel" Text="Start Listening" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{ThemeResource RimVMenuActionForegroundBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <InfoBar x:Name="ErrorInfo" IsOpen="False" Severity="Error" IsClosable="True" Margin="0,0,0,8"/>
                    <InfoBar x:Name="ModelInfo" IsOpen="False" Severity="Informational" Margin="0,0,0,8"/>
                    <Button x:Name="LanguageAnchor" Style="{StaticResource RimVMenuRowButtonStyle}" Click="LanguageButton_Click"
                            AutomationProperties.Name="Choose transcription language">
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="17"/>
                            <TextBlock Grid.Column="1" Text="Language" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LanguageName" Grid.Column="2" Text="Automatic" MaxWidth="180"
                                       TextTrimming="CharacterEllipsis" FontSize="14" VerticalAlignment="Center"
                                       Foreground="{ThemeResource RimVMenuSecondaryTextBrush}"/>
                            <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                        </Grid>
                    </Button>
                    <Button x:Name="ModelAnchor" Style="{StaticResource RimVMenuRowButtonStyle}" Click="ModelButton_Click"
                            AutomationProperties.Name="Choose transcription model">
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE950;" FontFamily="Segoe Fluent Icons" FontSize="17"/>
                            <TextBlock Grid.Column="1" Text="Model" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ModelName" Grid.Column="2" Text="Choose a model" MaxWidth="190"
                                       TextTrimming="CharacterEllipsis" FontSize="14" VerticalAlignment="Center"
                                       Foreground="{ThemeResource RimVMenuSecondaryTextBrush}"/>
                            <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                        </Grid>
                    </Button>
                    <Border Height="1" Background="{ThemeResource RimVMenuBorderBrush}" Margin="0,3"/>
                    <Button x:Name="RecordingsAnchor" Style="{StaticResource RimVMenuRowButtonStyle}" Click="RecordingsButton_Click"
                            AutomationProperties.Name="Open recordings">
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="17"/>
                            <TextBlock Grid.Column="1" Text="Recordings" FontSize="15" VerticalAlignment="Center"/>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                        </Grid>
                    </Button>
                    <Border Height="1" Background="{ThemeResource RimVMenuBorderBrush}" Margin="0,3"/>
                    <Button Style="{StaticResource RimVMenuRowButtonStyle}" Click="QuitButton_Click"
                            AutomationProperties.Name="Quit RimV, Ctrl+Q">
                        <Grid ColumnSpacing="9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="17"/>
                            <TextBlock Grid.Column="1" Text="Quit RimV" FontSize="15"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+Q" FontSize="12"
                                       Foreground="{ThemeResource RimVMenuSecondaryTextBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Canvas x:Name="BottomPointer" Height="14" VerticalAlignment="Bottom" Visibility="Collapsed">
            <Polygon x:Name="BottomPointerBorder" Points="0,0 24,0 12,14" Fill="{ThemeResource RimVMenuBorderBrush}"/>
            <Polygon x:Name="BottomPointerFill" Points="2,0 22,0 12,12" Fill="{ThemeResource RimVMenuSurfaceBrush}"/>
        </Canvas>
        <Canvas x:Name="TopPointer" Height="14" VerticalAlignment="Top" Visibility="Collapsed">
            <Polygon x:Name="TopPointerBorder" Points="0,14 24,14 12,0" Fill="{ThemeResource RimVMenuBorderBrush}"/>
            <Polygon x:Name="TopPointerFill" Points="2,14 22,14 12,2" Fill="{ThemeResource RimVMenuSurfaceBrush}"/>
        </Canvas>
        <Canvas x:Name="LeftPointer" Width="14" HorizontalAlignment="Left" Visibility="Collapsed">
            <Polygon x:Name="LeftPointerBorder" Points="14,0 14,24 0,12" Fill="{ThemeResource RimVMenuBorderBrush}"/>
            <Polygon x:Name="LeftPointerFill" Points="14,2 14,22 2,12" Fill="{ThemeResource RimVMenuSurfaceBrush}"/>
        </Canvas>
        <Canvas x:Name="RightPointer" Width="14" HorizontalAlignment="Right" Visibility="Collapsed">
            <Polygon x:Name="RightPointerBorder" Points="0,0 0,24 14,12" Fill="{ThemeResource RimVMenuBorderBrush}"/>
            <Polygon x:Name="RightPointerFill" Points="0,2 0,22 12,12" Fill="{ThemeResource RimVMenuSurfaceBrush}"/>
        </Canvas>
    </Grid>
</Window>
