<Window
    x:Class="RimV.Windows.ModelManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Model Manager">
    <Grid x:Name="RootGrid" Background="{ThemeResource RimVBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{ThemeResource RimVSecondaryBrush}" Padding="18,24">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="4" Margin="4,0,0,24">
                    <TextBlock Text="RimV" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Model Manager" Foreground="{ThemeResource RimVSecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="6">
                    <Button x:Name="AvailableTab" Content="Available Models" HorizontalContentAlignment="Left" Click="AvailableTab_Click" />
                    <Button x:Name="InstalledTab" Content="Installed Models" HorizontalContentAlignment="Left" Click="InstalledTab_Click" />
                    <Button x:Name="SettingsTab" Content="Settings" HorizontalContentAlignment="Left" Click="SettingsTab_Click" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Models run locally on your device." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource RimVSecondaryTextBrush}" Margin="4,12,4,0" />
            </Grid>
        </Border>
        <Grid Grid.Column="1" Padding="28,24" RowSpacing="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="PageTitle" Text="Available Models" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="PageDescription" Text="Download and manage your transcription models." Foreground="{ThemeResource RimVSecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <InfoBar x:Name="ErrorInfo" Grid.Row="1" IsOpen="False" Severity="Error" IsClosable="True" />
            <Grid x:Name="CatalogPage" Grid.Row="2">
                <ListView x:Name="ModelList" SelectionMode="None" AutomationProperties.Name="Speech model catalog">
                    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Spacing="12" /></ItemsPanelTemplate></ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ModelCardRow" xmlns:local="using:RimV.Windows">
                            <Border Background="{ThemeResource RimVSurfaceBrush}" BorderBrush="{ThemeResource RimVBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <Grid ColumnSpacing="16" RowSpacing="7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="{x:Bind SelectionLabel}" Foreground="{ThemeResource RimVLiveBrush}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Size}" Foreground="{ThemeResource RimVSecondaryTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind Description}" Foreground="{ThemeResource RimVSecondaryTextBrush}" TextWrapping="Wrap" />
                                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="8" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind StateText}" FontSize="12" Foreground="{ThemeResource RimVSecondaryTextBrush}" />
                                            <ProgressBar Value="{x:Bind ProgressPercent, Mode=OneWay}" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" Height="4" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{x:Bind ActionLabel}" Tag="{x:Bind Id}" IsEnabled="{x:Bind ActionEnabled}" Click="ModelActionButton_Click" />
                                        <Button Grid.Column="2" Content="Remove" Tag="{x:Bind Id}" Visibility="{x:Bind RemoveVisibility}" IsEnabled="{x:Bind RemoveEnabled}" Click="RemoveButton_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Text="No models match this view." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource RimVSecondaryTextBrush}" Visibility="Collapsed" />
            </Grid>
            <Grid x:Name="SettingsPage" Grid.Row="2" Visibility="Collapsed">
                <StackPanel Spacing="14" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="Model storage" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Downloaded models are stored on this device." Foreground="{ThemeResource RimVSecondaryTextBrush}" />
                    <Border Background="{ThemeResource RimVSurfaceBrush}" BorderBrush="{ThemeResource RimVBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="StoragePathText" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Open Folder" Click="OpenFolderButton_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
